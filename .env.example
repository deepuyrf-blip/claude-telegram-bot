# Telegram
TELEGRAM_BOT_TOKEN=8123456:AAH-your-token-from-BotFather
TELEGRAM_ALLOWED_CHATS=          # comma-separated chat ids; empty = lock to first chat

# Agent
AGENT_CWD=/workspace
AGENT_MODEL=sonnet
AGENT_PERMISSION_MODE=bypassPermissions
AGENT_MAX_TURNS=30

# Provider for Claude Code (or point at your own gateway)
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Optional: where /models pulls the list from
MODELS_URL=
MODELS_KEY=

# Standalone docker only
WORKSPACE_DIR=./workspace
CLAUDE_CONFIG=./claude
